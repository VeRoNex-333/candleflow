# Copy this file to .env and put real values there. Never commit .env.

# Warehouse: the Postgres container that stores CandleFlow's data
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5436
WAREHOUSE_DB=candleflow
WAREHOUSE_USER=candleflow
WAREHOUSE_PASSWORD=change_me
AIRFLOW_UID=50000
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=change_me